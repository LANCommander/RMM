# World objects, player damage/health, vehicle damage, push.
# Object handles in the simulator are allocated in order: 0x1, 0x2, ...
rmm caps
.join Alice 1
.join Bob 1
.join Carl 2
.spawn 0
.spawn 1
.spawn 2
# 0x1 carrier (drifting), 0x2 an AA seat on it, 0x3 a jeep
.vehicle carrier_yorktown 100 0 200 2 0 1
.seat 0x1 yorktown_aa
.vehicle willys 0 0 0
rmm objects
rmm objects *york* roots
# Alice mans the AA gun: the carrier root is now occupied
.enter 0 yorktown_aa 1
rmm objects carrier* empty
rmm object 0x2
.exit 0
rmm objects carrier* empty
# stop the drift, then nothing moves
.drift 5
rmm object 0x1 stop
.drift 5
rmm object 0x1
# moving a seat moves its root
rmm object 0x2 pos 10 20 30
rmm object 0x1
# vehicle damage with occupants
.enter 2 willys 0
.vdamage 0x3 0 50
# player damage API through the plugin ABI (basecommands)
# Carl is in the jeep: the jeep is launched with him
slap Carl 30
slap Carl 80
# Bob is on foot, launch without damage
slap Bob 0 12
# capturers (Alice and Bob are alive on team 1)
.capture Berlin_Cpoint 1
.players
# stale handles after a map change
.map gulf_of_oman gpm_cq 64
rmm object 0x1
rmm objects
